# Copy to .env (same folder as manifest.json) and fill in. .env is gitignored.
# Reload the extension in chrome://extensions after editing.
DEEPL_API_KEY=
ANTHROPIC_API_KEY=
# Optional: only if your credential spans several workspaces (wrkspc_...). A normal sk-ant key is
# already bound to its workspace; leave empty unless the API asks for it.
ANTHROPIC_WORKSPACE_ID=
# Optional, default claude-opus-5-5 (claude-haiku-5-5 is cheapest)
CLAUDE_MODEL=
